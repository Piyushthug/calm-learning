{
  "control-id": "SEC-002",
  "name": "TLS/mTLS Configuration",
  "description": "All service-to-service and client-to-service communication uses TLS 1.3 or higher with mTLS for internal services",
  "requirements": [
    {
      "protocol": "TLS 1.3",
      "minimum-version": "1.3",
      "cipher-suites": [
        "TLS_AES_256_GCM_SHA384",
        "TLS_CHACHA20_POLY1305_SHA256"
      ]
    },
    {
      "scope": "internal-services",
      "protocol": "mTLS",
      "certificate-management": "automated via cert-manager",
      "rotation-interval": "90 days"
    },
    {
      "scope": "external-apis",
      "protocol": "TLS 1.3",
      "certificate-pinning": "enabled for payment gateways"
    }
  ]
}
